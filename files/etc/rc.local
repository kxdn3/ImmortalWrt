#!/bin/sh
#
# x86 软路由（J4125 等 Gemini Lake / Goldmont Plus）性能调优
# 本文件由固件预置（仓库 files/etc/rc.local），每次开机由 /etc/init.d/done（S95done）调用。
# 改参数直接编辑本文件，重启生效。
#
# 说明（避免误解）：
#   * CPU 满载时 performance 与 ondemand 都是最高频，所以本脚本【不提升满载性能】。
#     governor 的价值是消除突发流量下的升频延迟（代理 / 游戏首包更稳），代价是空闲温度略升。
#     想省电把 GOV 改回 ondemand 即可。
#   * 中断亲和让多个核分担网卡收包；但单条 PPPoE 会话是单队列、pppd 单线程，
#     PPPoE 转发吃不到多核 —— 这里主要提升 LAN 侧转发与代理流量。
#   * RPS / RFS 不在此处设置：固件内置的 packet_steering 服务（S25packet_steering，
#     /usr/libexec/network/packet-steering.uc）会按 CPU 拓扑自适应分配 rps_cpus，
#     并在每次接口事件后自动重应用，优于此处硬编码（硬编码在非 4 核机器上还会写入失败）。
#     如需启用 RFS，需给 packet_steering 传入流表数（其 local_flows 默认为 0，即关闭）。

GOV=performance          # 调频策略：performance / ondemand
BACKLOG=2048             # 网卡软中断积压上限（packet_steering 不管此项）

# --- 1) 调频策略 ---
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$g" ] && echo "$GOV" > "$g"
done

# --- 2) 网卡中断亲和：把物理网卡的队列中断轮流分到各 CPU ---
# 掩码按实际核数自适应，避免在非 4 核机器上写越界的 cpumask
NCPU=$(ls -d /sys/devices/system/cpu/cpu[0-9]* 2>/dev/null | wc -l | tr -d ' ')
[ "$NCPU" -gt 0 ] 2>/dev/null || NCPU=1

i=0
for irq in $(awk '/eth[0-9]/{sub(/:/, "", $1); print $1}' /proc/interrupts); do
    mask=$(printf '%x' $((1 << (i % NCPU))))
    echo "$mask" > /proc/irq/$irq/smp_affinity 2>/dev/null
    i=$((i + 1))
done

# --- 3) 软中断积压上限 ---
[ -w /proc/sys/net/core/netdev_max_backlog ] && echo "$BACKLOG" > /proc/sys/net/core/netdev_max_backlog

exit 0
